<% content_for :title, "Dashboard — Open Window" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900"><%= current_user.organizations&.first&.name %></h1>
    <p class="mt-1 text-sm text-slate-500">Welcome, <%= current_user.email %></p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Team card %>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h2 class="text-base font-semibold text-slate-900">Your Team</h2>
      </div>
      <p class="text-sm text-slate-500 mb-6">Manage teammates, set roles, and control calendar visibility.</p>
      <%= link_to members_path, class: "block rounded-lg bg-slate-50 border border-slate-200 px-4 py-3 hover:bg-slate-100 transition-colors mb-3" do %>
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-slate-700">View team</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      <% end %>
      <% if current_user.memberships.super_admin.exists? %>
        <%= link_to "Invite teammate", new_invitation_path,
              class: "inline-block rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition-colors" %>
      <% end %>
    </div>

    <%# Availability card %>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="text-base font-semibold text-slate-900">Calendar Availability</h2>
      </div>
      <p class="text-sm text-slate-500 mb-6">See real-time open slots across your team's connected calendars.</p>
      <div class="rounded-lg bg-slate-50 border border-dashed border-slate-200 py-10 text-center">
        <p class="text-sm text-slate-400">Connect a calendar to see live availability.</p>
        <button class="mt-3 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 transition-colors">Connect calendar</button>
      </div>
    </div>
  </div>
</div>
