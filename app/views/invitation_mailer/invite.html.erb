<div style="font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; color: #0f172a; max-width: 480px; margin: 0 auto;">
  <h1 style="font-size: 20px; font-weight: 700; margin-bottom: 16px;">
    You're invited to join <%= @organization.name %>
  </h1>

  <p style="font-size: 14px; line-height: 1.6; color: #475569;">
    <%= @invited_by.email %> has invited you to join
    <strong><%= @organization.name %></strong> on Open Window.
  </p>

  <p style="font-size: 14px; line-height: 1.6; color: #475569;">
    Click the button below to set up your account and join the organization.
  </p>

  <p style="margin: 28px 0;">
    <%= link_to "Join #{@organization.name}", @accept_url,
          style: "display: inline-block; background-color: #4f46e5; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 20px; border-radius: 12px;" %>
  </p>

  <p style="font-size: 12px; line-height: 1.6; color: #94a3b8;">
    If the button doesn't work, copy and paste this link into your browser:<br>
    <a href="<%= @accept_url %>" style="color: #4f46e5;"><%= @accept_url %></a>
  </p>
</div>
