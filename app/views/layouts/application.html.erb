<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Open Window" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Open Window">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-slate-900 antialiased">
    <nav class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <a href="<%= root_path %>" class="flex items-center gap-2 text-indigo-600 font-bold text-xl tracking-tight">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Open Window
          </a>

          <div class="flex items-center gap-3">
            <% if user_signed_in? %>
              <%= link_to settings_path, class: "flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" do %>
                <% if current_user.profile_picture.attached? %>
                  <%= image_tag current_user.profile_picture.variant(:nav), class: "h-7 w-7 rounded-full object-cover ring-1 ring-slate-200" %>
                <% end %>
                Settings
              <% end %>
              <%= link_to "Dashboard", dashboard_path, class: "text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" %>
              <%= button_to "Log out", destroy_user_session_path, method: :delete,
                    class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer" %>
            <% else %>
              <%= link_to "Log in", new_user_session_path, class: "text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" %>
              <%= link_to "Sign up", new_user_registration_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition-colors" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
        <div class="rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-800"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800"><%= alert %></div>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
