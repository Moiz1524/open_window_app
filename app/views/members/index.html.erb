<% content_for :title, "Team — #{@organization.name}" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
  <%# Page header %>
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= @organization.name %></h1>
      <p class="mt-1 text-sm text-slate-500">Manage your team members and pending invitations.</p>
    </div>
    <% if current_user.memberships.super_admin.exists? %>
      <%= link_to new_invitation_path,
            class: "inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Invite teammate
      <% end %>
    <% end %>
  </div>

  <%# Tab container %>
  <div data-controller="tabs">
    <%# Tab nav %>
    <div class="border-b border-slate-200 mb-6">
      <nav class="-mb-px flex gap-6" aria-label="Tabs">
        <button
          type="button"
          role="tab"
          data-tabs-target="tab"
          data-tabs-key="accepted"
          data-action="click->tabs#show"
          aria-selected="true"
          class="inline-flex items-center gap-2 border-b-2 pb-3 text-sm font-medium transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Accepted
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600"><%= @members.size %></span>
        </button>

        <button
          type="button"
          role="tab"
          data-tabs-target="tab"
          data-tabs-key="pending"
          data-action="click->tabs#show"
          aria-selected="false"
          class="inline-flex items-center gap-2 border-b-2 pb-3 text-sm font-medium transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Pending
          <% if @pending_invitations.any? %>
            <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700"><%= @pending_invitations.size %></span>
          <% else %>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">0</span>
          <% end %>
        </button>
      </nav>
    </div>

    <%# Accepted panel %>
    <div data-tabs-target="panel" role="tabpanel">
      <% if @members.any? %>
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50">
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Member</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Role</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Joined</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @members.each do |membership| %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <% if membership.user.profile_picture.attached? %>
                        <%= image_tag membership.user.profile_picture.variant(:nav),
                              class: "h-8 w-8 rounded-full object-cover ring-1 ring-slate-200" %>
                      <% else %>
                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-indigo-100 text-indigo-600 text-xs font-semibold">
                          <%= membership.user.email[0].upcase %>
                        </div>
                      <% end %>
                      <div>
                        <p class="font-medium text-slate-900"><%= membership.user.email %></p>
                        <% if membership.user == current_user %>
                          <p class="text-xs text-slate-400">You</p>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <% if membership.super_admin? %>
                      <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-200">
                        Super admin
                      </span>
                    <% else %>
                      <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
                        Member
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-slate-500">
                    <%= membership.created_at.strftime("%b %-d, %Y") %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-200 bg-white py-16 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="text-sm font-medium text-slate-900">No members yet</p>
          <p class="mt-1 text-sm text-slate-500">Invite teammates to get started.</p>
        </div>
      <% end %>
    </div>

    <%# Pending panel %>
    <div data-tabs-target="panel" role="tabpanel" hidden>
      <% if @pending_invitations.any? %>
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50">
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Invited</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Role</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Invited by</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Sent</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @pending_invitations.each do |invitation| %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-amber-100 text-amber-600 text-xs font-semibold">
                        <%= invitation.email[0].upcase %>
                      </div>
                      <p class="font-medium text-slate-900"><%= invitation.email %></p>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <% if invitation.super_admin? %>
                      <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-200">
                        Super admin
                      </span>
                    <% else %>
                      <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
                        Member
                      </span>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-slate-500"><%= invitation.invited_by.email %></td>
                  <td class="px-6 py-4 text-slate-500"><%= invitation.created_at.strftime("%b %-d, %Y") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-200 bg-white py-16 text-center">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-sm font-medium text-slate-900">No pending invitations</p>
          <p class="mt-1 text-sm text-slate-500">All invitations have been accepted.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
