<% content_for :title, "Settings — Open Window" %>

<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-slate-900">Settings</h1>
    <p class="mt-1 text-sm text-slate-500">Manage your profile and account preferences.</p>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-base font-semibold text-slate-900 mb-1">Profile picture</h2>
    <p class="text-sm text-slate-500 mb-6">PNG, JPEG, WEBP, or GIF up to 5&nbsp;MB.</p>

    <div class="flex items-center gap-6">
      <div class="shrink-0">
        <% if current_user.profile_picture.attached? %>
          <%= image_tag current_user.profile_picture.variant(:thumb),
                class: "h-24 w-24 rounded-full object-cover ring-1 ring-slate-200" %>
        <% else %>
          <div class="flex h-24 w-24 items-center justify-center rounded-full bg-slate-100 text-slate-400 ring-1 ring-slate-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
        <% end %>
      </div>

      <div class="flex-1 space-y-4">
        <%= form_with model: current_user, url: settings_path, method: :patch, html: { class: "space-y-4" } do |f| %>
          <%= f.file_field :profile_picture,
                accept: "image/png,image/jpeg,image/webp,image/gif",
                class: "block w-full text-sm text-slate-600 file:mr-4 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-medium file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" %>

          <%= f.submit (current_user.profile_picture.attached? ? "Update picture" : "Upload picture"),
                class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition-colors cursor-pointer" %>
        <% end %>

        <% if current_user.profile_picture.attached? %>
          <%= button_to "Remove picture", settings_profile_picture_path, method: :delete,
                form: { data: { turbo_confirm: "Remove your profile picture?" } },
                class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
